{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# EDA: pilot_merged.csv\n",
    "Facility distributions, population relationships, per-capita state variance. Surface data weirdness before D-HAI lock-in."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "# Load data\n",
    "df = pd.read_csv('pilot_merged.csv')\n",
    "print(f\"Shape: {df.shape}\")\n",
    "print(f\"\\nColumns: {df.columns.tolist()}\")\n",
    "print(f\"\\nData types:\\n{df.dtypes}\")\n",
    "print(f\"\\nFirst few rows:\")\n",
    "print(df.head())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Quick inspection\n",
    "print(\"Missing values:\")\n",
    "print(df.isnull().sum())\n",
    "print(f\"\\nUnique states: {df['state'].nunique()}\")\n",
    "print(f\"States: {sorted(df['state'].unique())}\")\n",
    "print(f\"\\nYear range: {df['year'].unique()}\")\n",
    "print(f\"\\nBasic stats:\")\n",
    "df.describe()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Facility Count Distributions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "facility_cols = ['sub_centres', 'phcs', 'chcs', 'sub_divisional_hospital', 'district_hospital']\n",
    "\n",
    "fig, axes = plt.subplots(len(facility_cols), 1, figsize=(10, 3*len(facility_cols)))\n",
    "\n",
    "for ax, col in zip(axes, facility_cols):\n",
    "    ax.hist(df[col].dropna(), bins=30, edgecolor='black', alpha=0.7, color='steelblue')\n",
    "    ax.set_title(f\"Distribution: {col}\", fontsize=12, fontweight='bold')\n",
    "    ax.set_xlabel(col)\n",
    "    ax.set_ylabel(\"Frequency (districts)\")\n",
    "    ax.grid(alpha=0.3, axis='y')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('01_facility_distributions.png', dpi=100, bbox_inches='tight')\n",
    "plt.show()\n",
    "\n",
    "print(\"Facility count summary:\")\n",
    "for col in facility_cols:\n",
    "    print(f\"\\n{col}:\")\n",
    "    print(f\"  Min: {df[col].min()}, Max: {df[col].max()}, Mean: {df[col].mean():.2f}, Median: {df[col].median():.0f}\")\n",
    "    print(f\"  Skew: {df[col].skew():.2f}, Zeros: {(df[col] == 0).sum()}, Null: {df[col].isnull().sum()}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Population vs Facility Counts"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Scatter plots: population vs each facility count\n",
    "fig, axes = plt.subplots(2, 3, figsize=(15, 10))\n",
    "axes = axes.flatten()\n",
    "\n",
    "for i, col in enumerate(facility_cols):\n",
    "    ax = axes[i]\n",
    "    ax.scatter(df['population'], df[col], alpha=0.6, s=30, color='darkblue')\n",
    "    ax.set_xlabel('Population', fontsize=10)\n",
    "    ax.set_ylabel(col, fontsize=10)\n",
    "    ax.set_title(f\"{col} vs Population\", fontsize=11, fontweight='bold')\n",
    "    ax.grid(alpha=0.3)\n",
    "    \n",
    "    # Correlation\n",
    "    corr = df['population'].corr(df[col])\n",
    "    ax.text(0.05, 0.95, f\"r = {corr:.3f}\", transform=ax.transAxes, \n",
    "           verticalalignment='top', bbox=dict(boxstyle='round', facecolor='wheat', alpha=0.7), fontsize=9)\n",
    "\n",
    "# Hide the last unused subplot\n",
    "axes[-1].set_visible(False)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('02_population_vs_facilities.png', dpi=100, bbox_inches='tight')\n",
    "plt.show()\n",
    "\n",
    "print(\"Correlations (Population vs Facilities):\")\n",
    "for col in facility_cols:\n",
    "    corr = df['population'].corr(df[col])\n",
    "    print(f\"  {col}: {corr:.3f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Per-Capita Values by State"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Calculate per-capita for each facility type (per 100k population)\n",
    "df_percapita = df.copy()\n",
    "for col in facility_cols:\n",
    "    df_percapita[f\"{col}_per_capita\"] = (df[col] / df['population']) * 100000\n",
    "\n",
    "percapita_cols = [f\"{col}_per_capita\" for col in facility_cols]\n",
    "\n",
    "# State-level aggregation (mean per-capita)\n",
    "state_summary = df_percapita.groupby('state')[percapita_cols].mean().sort_values('sub_centres_per_capita', ascending=False)\n",
    "\n",
    "print(\"Per-capita facilities (per 100k population) by state:\\n\")\n",
    "print(state_summary.round(2))\n",
    "\n",
    "# Plot per-capita variance by state\n",
    "fig, axes = plt.subplots(2, 3, figsize=(16, 10))\n",
    "axes = axes.flatten()\n",
    "\n",
    "for i, col in enumerate(percapita_cols):\n",
    "    ax = axes[i]\n",
    "    state_summary[col].sort_values(ascending=True).plot(kind='barh', ax=ax, color='steelblue', edgecolor='black', alpha=0.7)\n",
    "    ax.set_xlabel(f\"Per-Capita Rate (per 100k)\")\n",
    "    ax.set_title(col.replace('_per_capita', '') + \" per Capita by State\", fontsize=11, fontweight='bold')\n",
    "    ax.grid(alpha=0.3, axis='x')\n",
    "\n",
    "# Hide the last unused subplot\n",
    "axes[-1].set_visible(False)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('03_percapita_by_state.png', dpi=100, bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Outliers & Anomalies"
   ]
  },
  {
   "cell_type": {"cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# IQR-based outlier detection\n",
    "print(\"Potential outliers (IQR method):\\n\")\n",
    "all_cols = facility_cols + ['population']\n",
    "\n",
    "outlier_summary = {}\n",
    "for col in all_cols:\n",
    "    Q1 = df[col].quantile(0.25)\n",
    "    Q3 = df[col].quantile(0.75)\n",
    "    IQR = Q3 - Q1\n",
    "    lower_bound = Q1 - 1.5*IQR\n",
    "    upper_bound = Q3 + 1.5*IQR\n",
    "    \n",
    "    outliers = df[(df[col] < lower_bound) | (df[col] > upper_bound)]\n",
    "    outlier_summary[col] = len(outliers)\n",
    "    \n",
    "    if len(outliers) > 0:\n",
    "        print(f\"{col}: {len(outliers)} outliers\")\n",
    "        print(outliers[['state', 'district', 'population'] + facility_cols].head(3))\n",
    "        print()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Data Quality Flags"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Check for issues\n",
    "issues = []\n",
    "\n",
    "# Zero/negative populations\n",
    "if (df['population'] <= 0).any():\n",
    "    issues.append(f\"❌ Non-positive populations: {(df['population'] <= 0).sum()} rows\")\n",
    "else:\n",
    "    issues.append(f\"✅ All populations positive\")\n",
    "\n",
    "# Zero facility counts\n",
    "for col in facility_cols:\n",
    "    zero_count = (df[col] == 0).sum()\n",
    "    pct = 100 * zero_count / len(df)\n",
    "    if zero_count > 0:\n",
    "        issues.append(f\"ℹ️  {col}: {zero_count} zeros ({pct:.1f}%)\")\n",
    "\n",
    "# Facility counts > population (should be impossible)\n",
    "for col in facility_cols:\n",
    "    if (df[col] > df['population']).any():\n",
    "        impossible = (df[col] > df['population']).sum()\n",
    "        issues.append(f\"❌ {col}: {impossible} rows with count > population\")\n",
    "\n",
    "# High variance per-capita\n",
    "for col in percapita_cols:\n",
    "    mean_val = df_percapita[col].mean()\n",
    "    if mean_val > 0:\n",
    "        cv = df_percapita[col].std() / mean_val  # coefficient of variation\n",
    "        if cv > 1:\n",
    "            issues.append(f\"📊 {col}: High CV ({cv:.2f}) — large per-capita variance\")\n",
    "\n",
    "# Check missing data\n",
    "missing_total = df.isnull().sum().sum()\n",
    "if missing_total == 0:\n",
    "    issues.append(f\"✅ No missing values\")\nelse:\n",
    "    issues.append(f\"⚠️  {missing_total} total missing values\")\n",
    "\n",
    "print(\"\\n🚩 Data Quality Report:\")\n",
    "print(\"=\"*50)\n",
    "for issue in issues:\n",
    "    print(issue)\n",
    "print(\"=\"*50)\n",
    "print(f\"\\nTotal rows: {len(df)}\")\n",
    "print(f\"Total states: {df['state'].nunique()}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Summary Stats by State"
   ]
  },
  {
   "cell_type": {"cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# District count and population by state\n",
    "state_detail = df.groupby('state').agg({\n",
    "    'district': 'count',\n",
    "    'population': ['sum', 'mean', 'min', 'max']\n",
    "}).round(0)\n",
    "\n",
    "state_detail.columns = ['num_districts', 'total_population', 'mean_pop', 'min_pop', 'max_pop']\n",
    "state_detail = state_detail.sort_values('total_population', ascending=False)\n",
    "\n",
    "print(\"\\nState Summary (sorted by total population):\\n\")\n",
    "print(state_detail.astype(int))"
   ]
  }
 ],
